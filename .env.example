# Copy to .env (gitignored) to supply secrets to docker-compose.
GROQ_API_KEY=gsk_your_groq_key_here
GEOAPIFY_KEY=your_geoapify_key_here
# ReportAll USA parcel API client key (https://reportallusa.com/account/api) - pins searches to the exact property lot.
REPORTALL_CLIENT_KEY=your_reportall_client_key_here
# Google Solar API key (console.cloud.google.com, enable "Solar API") - current aerial surface for lot drainage.
GOOGLE_SOLAR_KEY=your_google_solar_key_here
# Human check before the app: "code" (typed captcha, default, no keys), "turnstile" (Cloudflare, needs the
# two keys below) or "off".
HUMAN_CHECK_MODE=code
# Only for HUMAN_CHECK_MODE=turnstile — dash.cloudflare.com -> Turnstile -> Add widget. Cloudflare's test keys
# always pass: site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signs the session pass after the check; any random string of 32+ characters. Keeps passes valid across restarts.
SESSION_SIGNING_KEY=
